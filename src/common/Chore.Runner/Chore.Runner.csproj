<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chore</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Chore.Cli</PackageId>
    <Version>0.0.0-betta1</Version>
    <Authors>Alex Zhedik</Authors>
    <Description>Cli tools to speed up software development routines</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None
      Include="..\..\handlers\Chore.*\bin\$(Configuration)\$(TargetFramework)\**\*.*"
      Link="Handlers\%(Filename)%(Extension)"
      Pack="true"
      PackagePath="tools\$(TargetFramework)\any\Handlers"
      CopyToOutputDirectory="Never"
    ></None>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None
      Include="..\..\handlers\Chore.*\bin\$(Configuration)\$(TargetFramework)\**\*.*"
      Link="Handlers\%(Filename)%(Extension)"
      CopyToOutputDirectory="Always"
    ></None>
  </ItemGroup>
</Project>
